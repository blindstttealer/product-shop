    "/api/user/settings": {
      "get": {
        "operationId": "SettingsController_getSettings",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        },
        "tags": [
          "settings"
        ],
        "security": [
          {
            "cookies": []
          }
        ]
      },
      "put": {
        "operationId": "SettingsController_saveSettings",
        "summary": "Save user settings",
        "description": "Send multipart/form-data: field `settings` — JSON string (SaveSettingsDto); optional file field `photo`.",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "settings"
                ],
                "properties": {
                  "settings": {
                    "type": "string",
                    "description": "Stringified JSON matching SaveSettingsDto"
                  },
                  "photo": {
                    "type": "string",
                    "format": "binary",
                    "description": "Optional profile image (JPEG, PNG, WebP, GIF), max 5 MB"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        },
        "tags": [
          "settings"
        ],
        "security": [
          {
            "cookies": []
          }
        ]
      }
    }
