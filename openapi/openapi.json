  "info": {
    "title": "Workforms API",
    "description": "HTTP API (WebSocket chat is not described here)",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "short_token",
        "description": "HttpOnly cookies from POST /api/user/login or /api/user/register (short_token or long_token)."
      }
    },
    "schemas": {
      "RegisterUserDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string",
            "minLength": 3
          },
          "login": {
            "type": "string",
            "minLength": 3
          }
        },
        "required": [
          "email",
          "password",
          "login"
        ]
      },
      "LoginUserDto": {
        "type": "object",
        "properties": {
          "login": {
            "type": "string",
            "minLength": 1
          },
          "password": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "login",
          "password"
        ]
      }
    }
  }
